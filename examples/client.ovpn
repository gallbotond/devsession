# Relative referenced files are copied into private root-controlled storage.
client
dev tun
proto udp
remote vpn.example.com 1194
nobind
ca ca.crt
cert client.crt
key client.key
remote-cert-tls server
data-ciphers AES-256-GCM:AES-128-GCM
auth SHA256
persist-key
persist-tun
# auth-user-pass credentials.txt
# tls-crypt tls-crypt.key
# No hooks, plugins, scripts or nested configuration files.
